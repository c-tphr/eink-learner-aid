{
  "description": "cp_skip_grades at the end: c0002-p1 and c0002-p2 are graded; c0002-p3 was only skipped and has no grade; no checkpoint is in progress.",
  "type": "object",
  "required": ["version", "book_sha256", "grades", "position"],
  "not": { "required": ["active_checkpoint"] },
  "properties": {
    "grades": {
      "type": "object",
      "required": ["c0002-p1", "c0002-p2"],
      "additionalProperties": false,
      "properties": {
        "c0002-p1": { "type": "object", "required": ["first"] },
        "c0002-p2": { "type": "object", "required": ["first"] }
      }
    }
  }
}
